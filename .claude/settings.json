{
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(nix eval *)",
      "Bash(nix path-info *)",
      "Bash(opencode models)",
      "Bash(opencode models *)",
      "Bash(nix develop -c python3 -m wc1.symbols)",
      "Bash(nix develop -c make progress)",
      "Bash(nix develop -c make symbols)",
      "Bash(nix develop -c python3 -m wc1.progress *)",
      "Bash(nix develop -c python3 -m wc1.dis *)",
      "Bash(nix develop -c python3 -m wc1.xref *)",
      "Bash(nix log *)",
      "Bash(nix develop -c make help)"
    ]
  }
}
